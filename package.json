{
  "name": "@aquaticcalf/pi-plugins",
  "version": "0.1.0",
  "description": "A collection of independently loadable pi plugins.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-plugins"
  ],
  "files": [
    "plugins",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./plugins/*/index.ts"
    ],
    "themes": [
      "./plugins/*/themes/*.json"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:",
    "typebox": "catalog:"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "catalog:",
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-tui": "catalog:",
    "@types/node": "catalog:",
    "typebox": "catalog:",
    "typescript": "catalog:"
  }
}
